// Sitio de chivaspass en Cloudflare Workers (solo archivos estáticos).
// Supabase sigue siendo la base de datos, el login y las funciones de venta.
//   npm run deploy        → compila y publica
//   npx wrangler login    → una vez, para enlazar tu cuenta de Cloudflare
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chivaspass",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    // Vue Router resuelve las rutas (/ticket/:id, /panel/...): cualquier ruta
    // sin archivo devuelve index.html con 200.
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
  // Dominio propio: descomentar cuando chivaspass.com esté en Cloudflare.
  // "routes": [
  //   { "pattern": "chivaspass.com", "custom_domain": true },
  //   { "pattern": "www.chivaspass.com", "custom_domain": true }
  // ]
}
