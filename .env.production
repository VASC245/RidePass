# Valores públicos por diseño (van dentro del bundle). Los usa cualquier
# build de producción: Cloudflare, Netlify o local con `npm run build`.
VITE_SUPABASE_URL=https://cyyzudhjpifpbpeiebsn.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN5eXp1ZGhqcGlmcGJwZWllYnNuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk0ODcxNTAsImV4cCI6MjA5NTA2MzE1MH0.AJTmYJid24Fq_lfR8vZcrCbcQbESCWQXhGQ8zhkwkIA
VITE_PUBLIC_APP_NAME=chivaspass

# Pago con tarjeta vía PayPhone (Botón de Pagos + Split). Encenderlo solo
# cuando los secrets PAYPHONE_* estén en Supabase y el split esté activado.
VITE_PAYPHONE_ENABLED=false

# Captcha de Cloudflare Turnstile (widget "chivaspass", hostnames workers.dev
# y chivaspass.com). La clave pública va en el bundle; la secreta es el secret
# TURNSTILE_SECRET_KEY en Supabase. Publicar la web ANTES de cargar el secret:
# con el secret y sin esta clave, las reservas públicas fallarían.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAF8NFCWsxyWh8I9T

# Pase del ticket en Apple Wallet y Google Wallet (edge function wallet-pass).
# Encender cada uno solo cuando sus secrets estén en Supabase (APPLE_* o
# GOOGLE_WALLET_*); sin ellos el botón llevaría a "no disponible".
VITE_WALLET_APPLE=false
VITE_WALLET_GOOGLE=false
